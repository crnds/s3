# Seller package, factory backup, city list (~1.1GB) — kept locally, never tracked
docs/
# cats/ is tracked: its GIFs are embedded in the firmware (tools/embed_cats.py).
# Library source: tools/prepare_cat_gifs.py --width 480 --height 320
cats_raw/
# Local API tokens (AQICN_TOKEN, GIPHY_API_KEY) read by server/ and tools/
secrets.local.json
# Generated by tools/embed_cats.py on every build
src/cats_embed.gen.cpp
# Local WiFi/server config (copy src/config.example.h)
src/config.h
# Build output + tooling cruft
.pio/
.vscode/
__pycache__/
*.pyc
.DS_Store
shots/
# tools/sim_check.mjs: Playwright installed ad hoc (no package.json), failure output
node_modules/
tests/out/
.playwright-mcp/
